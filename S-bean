    <bean id="csvExportLead" class="com.salesforce.dataloader.process.ProcessRunner" scope="singleton">
		<description>Export Leads which are to be deleted</description>
        <property name="name" value="csvExportLead"/>
        <property name="configOverrideMap">
        <map>
			<entry key="sfdc.endpoint" value="https://nationallife.my.salesforce.com"/>
                <entry key="sfdc.username" value="datamanagement.user@nationallife.com"/>
                <!-- password below has been encrypted using key file, therefore it will not work without the key setting: process.encryptionKeyFile
                the password is not a valid encrypted value, please generate the real value using encrypt.bat utility -->
		<entry key="sfdc.password" value="26d89198e4100aafabb16fd743ade0e93931e48abd7b7822e24c336921194f1c8348cb5b1105209ca3e882007283e5c78847dea1ca4b13d344e134d196ff34f6"/>  
			<entry key="process.encryptionKeyFile" value="D:\NLG\Config\dataLoader.key"/>
			<entry key="sfdc.timeoutSecs" value="600"/>
			<entry key="sfdc.loadBatchSize" value="200"/>
			<entry key="sfdc.entity" value="Lead"/>
			<entry key="process.operation" value="extract"/>
			<entry key="dataAccess.type" value="csvWrite"/>
